‏# Meta / WhatsApp Cloud API
‏WHATSAPP_TOKEN=            # Permanent access token (System User)
‏PHONE_NUMBER_ID=           # من لوحة WhatsApp > API Setup
‏VERIFY_TOKEN=change-me     # أي نص سري تختاره، تكتبه أيضًا في Meta
‏APP_SECRET=                # Meta App > Settings > Basic > App Secret

‏# Claude
‏ANTHROPIC_API_KEY=
‏CLAUDE_MODEL=claude-haiku-4-5-20251001

# إعدادات
‏TZ_NAME=Asia/Riyadh
‏CURRENCY=ر.س
‏DB_PATH=shop.db

# الرسائل الصوتية (Claude لا يحوّل الصوت إلى نص، لذا نستخدم خدمة تفريغ)
‏OPENAI_API_KEY=
‏STT_LANG=ar
‏LOW_STOCK=5                # تنبيه عند وصول الكمية لهذا الحد
